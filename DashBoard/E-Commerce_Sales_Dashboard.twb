    <datasource caption='sales_cleaned (ecommerce)' inline='true' name='federated.080lki30rhobxq1dyuu9x0anpw03' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='localhost' name='mysql.1ee4ph212uwdxg18qabe808xrrom'>
            <connection class='mysql' dbname='ecommerce' odbc-native-protocol='' one-time-sql='' port='3306' server='localhost' source-charset='' username='sanjana' />
          </named-connection>
        </named-connections>
        <relation type='collection'>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='sales_cleaned' table='[sales_cleaned]' type='table' />
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query7' type='text'>select title,final_price as top_expensive_products from sales_cleaned order by final_price Desc limit 10</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query10' type='text'>select seller_name,sum(ratings_count) as total_reviews from sales_cleaned group by seller_name order by total_reviews Desc limit 10</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query8' type='text'>select seller_name,count(product_id) as total_products from sales_cleaned group by seller_name order by total_products Desc limit 10</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query5' type='text'>select title,ratings_count as top_reviewed_products from sales_cleaned order by ratings_count Desc limit 10</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query1' type='text'>SELECT&#13;
    category,&#13;
    AVG(final_price) AS Average_Price_by_Category&#13;
FROM sales_cleaned&#13;
GROUP BY category&#13;
ORDER BY Average_Price_by_Category DESC</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query3' type='text'>select category,sum(ratings_count) as total_reviews from sales_cleaned group by category order by total_reviews Desc</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query' type='text'>select  category,count(product_id) as number_of_products from sales_cleaned group by category order by number_of_products Desc</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query4' type='text'>select title,rating as top_rated_products from sales_cleaned order by rating Desc limit 10</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query2' type='text'>select category,avg(rating) as average_rating from sales_cleaned group by category order by average_rating Desc</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query6' type='text'>select title,discount as top_discounted_products from sales_cleaned order by discount Desc limit 10</relation>
          <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query9' type='text'>select seller_name,avg(rating) as avg_rating from sales_cleaned group by seller_name order by avg_rating Desc limit 10</relation>
        </relation>
