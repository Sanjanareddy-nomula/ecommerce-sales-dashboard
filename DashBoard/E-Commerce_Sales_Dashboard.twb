          <object caption='Custom SQL Query10' id='_24C03D9E143B4626B31C3473E3D4E06A'>
            <properties context=''>
              <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query10' type='text'>select seller_name,sum(ratings_count) as total_reviews from sales_cleaned group by seller_name order by total_reviews Desc limit 10</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query8' id='_3839F5BCB50744C98B316B690E137796'>
            <properties context=''>
              <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query8' type='text'>select seller_name,count(product_id) as total_products from sales_cleaned group by seller_name order by total_products Desc limit 10</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query5' id='_3C55FD0E72DE42FF8F9602A5A228E8A1'>
            <properties context=''>
              <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query5' type='text'>select title,ratings_count as top_reviewed_products from sales_cleaned order by ratings_count Desc limit 10</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query1' id='_65F31795AD924C428CBB56BF632658BB'>
            <properties context=''>
              <relation connection='mysql.1ee4ph212uwdxg18qabe808xrrom' name='Custom SQL Query1' type='text'>SELECT&#13;
    category,&#13;
    AVG(final_price) AS Average_Price_by_Category&#13;
FROM sales_cleaned&#13;
GROUP BY category&#13;
ORDER BY Average_Price_by_Category DESC</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query3' id='_65FB431381AF498E8526125EB8EBA7F6'>
